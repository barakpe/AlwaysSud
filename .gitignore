# logs/ versions only hand-written artifacts: the REPORTs, the handoff block that
# docs/HANDOFF.md requires in the branch, and the models the analysis rests on.
# Anything a tool printed is reproducible by re-running the skill - not versioned.
logs/**/qsyn_output_files/
logs/**/output_files/
logs/**/*.rpt
logs/**/*.qsf
logs/**/*.qpf
logs/**/*.pin
logs/**/*.smsg
logs/**/*.txt
